{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "bun",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "reels-preview",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "serve",
        ".",
        "-l",
        "3456",
        "--no-clipboard"
      ],
      "port": 3456,
      "url": "http://localhost:3456/nutriflow-reels-ads.html"
    },
    {
      "name": "production",
      "url": "https://nutriflow.inf.br"
    },
    {
      "name": "production-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["serve", "dist", "-l", "3000", "--no-clipboard"],
      "port": 3000
    }
  ]
}