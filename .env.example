# Supabase (Obrigatório)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PROJECT_ID=your_project_id
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Edge Functions API Keys (Configurar no Supabase Dashboard)
# Acesse: https://supabase.com/dashboard/project/YOUR_PROJECT_ID/settings/functions
# Adicione como Secret: OPENAI_API_KEY
# Obtenha em: https://platform.openai.com/api-keys

# Gemini AI (Opcional - alternativa local para gerar campanhas)
VITE_GEMINI_API_KEY=your_gemini_api_key

# Meta Ads API (Opcional - para criar campanhas automaticamente)
VITE_META_ACCESS_TOKEN=your_meta_access_token
VITE_META_AD_ACCOUNT_ID=act_123456789
VITE_META_PIXEL_ID=your_pixel_id

# Stripe (Opcional - para pagamentos)
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_key

# Monitoring (Opcional)
VITE_SENTRY_DSN=your_sentry_dsn
VITE_POSTHOG_KEY=your_posthog_key
